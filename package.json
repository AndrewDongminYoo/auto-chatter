{
  "name": "automations",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/instagram/main.ts",
    "worker:instagram": "node src/instagram/worker-main.ts --run",
    "meta:check": "node src/instagram/worker-main.ts --check-permissions",
    "check-types": "tsc --noEmit",
    "test": "node --test src/instagram/webhook.test.ts src/instagram/reply-policy.test.ts src/instagram/facebook-private-reply.test.ts src/instagram/instagram-login-private-reply.test.ts src/instagram/worker-main.test.ts",
    "test:db": "node --test --test-concurrency=1 src/instagram/http.db.test.ts src/instagram/reply-worker.db.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
