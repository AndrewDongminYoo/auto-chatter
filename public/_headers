# The dashboard files carry no user data and their names are not versioned, so browsers may keep them but must
# revalidate on every load (ETag, 304 without a body): a deploy is never served stale, and an unchanged file is
# not downloaded again (#199).
/app/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://*.cdninstagram.com https://*.fbcdn.net; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

# The landing page at "/" and its files: same-origin scripts, styles, images and fonts only, no user data.
/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache
/landing/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

# The font directory name carries the Pretendard release, so a file at one path never changes.
/fonts/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable
