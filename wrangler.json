{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-chatter",
  "account_id": "dd47bef237425c1e64a1bc9a2aa64310",
  "main": "src/cloudflare/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public" },
  "vars": {
    "SEND_ENABLED": "false",
    "META_INSTAGRAM_ACCOUNT_ID": "17841437471464257",
    "META_INSTAGRAM_CONNECTION_ID": "a5df4215-fb1e-46d4-93f4-13c0176fb031",
    "META_GRAPH_VERSION": "v26.0"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "026b7ba593a24852bbfd182456ff1c03" }],
  "queues": {
    "producers": [{ "binding": "REPLY_QUEUE", "queue": "auto-chatter-replies" }],
    "consumers": [
      {
        "queue": "auto-chatter-replies",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 60
      }
    ]
  },
  "triggers": { "crons": ["* * * * *"] }
}
