# Runtime configuration reference; keep real values out of Git.
# Node package scripts do not load env files automatically.
# Export Node variables before running package scripts, or use Node --env-file.
# Compose uses deploy/environment.example copied to deploy/runtime.env instead.

# Shared webhook secrets: Node receiver environment / Cloudflare Worker secrets.
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Shared Graph version: Node environment / Cloudflare wrangler.json vars.
META_GRAPH_VERSION=v26.0

# Node receiver and sending worker only; Cloudflare uses HYPERDRIVE instead.
DATABASE_URL=
# Optional Node receiver settings (shown defaults).
HOST=127.0.0.1
PORT=3000

# Node Meta checks and single-account worker only; not used by Cloudflare.
# Instagram Login checks need the Graph version, account ID and access token.
META_LOGIN_MODE=instagram
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
# Required for Node --run; also required for Facebook Login permission checks.
META_INSTAGRAM_CONNECTION_ID=

# Node Facebook Login only (set META_LOGIN_MODE=facebook).
META_APP_ID=
META_APP_ACCESS_TOKEN=
META_USER_ACCESS_TOKEN=
META_PAGE_ID=

# Cloudflare only: set these non-secret values in wrangler.json vars.
# Wrangler commands use --env-file /dev/null; this file is not deployed.
APP_ORIGIN=
SUPABASE_URL=
INSTAGRAM_OAUTH_APP_ID=
# Cloudflare global switch only. It does not disable the Node sending worker.
# Cloudflare also requires per-account send_enabled, a valid DB token and rules.
SEND_ENABLED=false
# Cloudflare OAuth launch gate. Keep false until Meta public access and non-role testing are verified.
INSTAGRAM_PUBLIC_CONNECT_ENABLED=false

# Cloudflare only: register each with wrangler secret put NAME --env-file /dev/null.
SUPABASE_PUBLISHABLE_KEY=
INSTAGRAM_OAUTH_APP_SECRET=
# Verified email addresses for temporary reviewer access; each address must also have a Meta app role.
INSTAGRAM_INTERNAL_EMAILS=
# Generate once with: openssl rand -base64 32
# Back up securely; replacing this key makes existing DB tokens unreadable.
TOKEN_ENCRYPTION_KEY=
# Account access tokens are stored encrypted through OAuth, not Worker secrets.
