# Copy to deploy/runtime.env; keep real values out of Git.
# Generate distinct values with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Use an immutable release identifier, such as a Git commit SHA.
APP_IMAGE_TAG=local
INGRESS_PORT=3000

# Set a DNS hostname before enabling the public profile.
WEBHOOK_DOMAIN=localhost
PROXY_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Required only for the send profile. This deployment uses Instagram Login.
META_GRAPH_VERSION=
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_CONNECTION_ID=
